# Feature gates.  Defaults mirror arkrtos_features.h exactly; a disabled
# feature still lets kernelsrc compile (CI builds a trimmed kernel).

menu "Kernel core"

config ARKRTOS_USE_SPINLOCK
	bool "Spinlock"
	default y
	help
	  Kernel spinlock (arkrtos_spin).  Off does not remove locking: it
	  swaps in a plain interrupt-disable implementation, which is enough
	  on a single core.  The object and device tables still rely on the
	  lock semantics, so "off" means "cheaper", not "unlocked".

config ARKRTOS_USE_SCHED_LOCK
	bool
	default y
	help
	  Scheduler lock (SVC 0x1B lock/unlock).  Mandatory: the lock has no
	  honest fallback, so arkrtos_features.h rejects anything but 1.

config ARKRTOS_USE_SMP
	bool "SMP scaffolding"
	default n
	help
	  每核状态块 + 次核启动入口 + 核间中断通路 + 在线核掩码。
	  默认关，也必须说清楚它不是什么：本内核的调度器是单核设计
	  （全局当前任务号、全局就绪位图、全局延迟队列），打开这个开关
	  不会把调度器变成多核。只打开它时，次核仍然只跑 WFI 空转、
	  不参与调度；要让次核跑任务，还要再打开 ARKRTOS_USE_SMP_SCHED。
	  关档下类型与符号都不存在，体积与行为逐位不变。

config ARKRTOS_USE_SMP_SCHED
	bool "Per-core scheduling (AMP): explicit task migration to a secondary core"
	default n
	depends on ARKRTOS_USE_SMP
	help
	  次核上跑一份**自己的**小调度器（每核运行队列 + idle 帧 + 时间片），
	  任务由调用方 arkrtos_smp_sched_task_to() 显式迁过去、
	  arkrtos_smp_sched_task_back() 显式要回。

	  这不是对称多核：全局当前任务号 / 就绪位图 / 延时链仍然只有 CPU0
	  一份，没有自动负载均衡。四条限制由代码强制（不是"暂未实现"）：
	  次核不许发 SVC 或调内核 API（遇 SYS 一律致命停机）、只接受 READY
	  任务迁移、次核节拍不推进全局 tick、迁移是「请求 + 每拍轮询」
	  故延迟上限 1 拍。要求 ARKRTOS_CPU_NUM >= 2（不满足直接 #error）。
	  关档下模块编成空目标，体积与行为不变。

config ARKRTOS_USE_STACK_USAGE
config ARKRTOS_USE_SMP_BALANCE
	bool "Automatic load balancing across the AMP queues"
	default n
	depends on ARKRTOS_USE_SMP_SCHED
	help
	  在调度分核（AMP）之上加一条自动策略：CPU0 每拍看一眼次核，次核
	  空闲且候选表里有任务在 CPU0 就绪集时迁一个过去；次核排了两个
	  以上而 CPU0 一件就绪任务都没有时要回一个。只处理调用方用
	  arkrtos_smp_sched_auto_add() 显式登记的候选任务。

	  它不是对称调度：次核仍然不许发 SVC / 调内核 API，所以只能迁移
	  「纯计算、不碰内核对象」的任务；自动迁移一个会发 SVC 的任务会让它
	  当场致命停机。要求 ARKRTOS_USE_SMP_SCHED=1 与 ARKRTOS_CPU_NUM>=2
	  （不满足直接 #error）。默认关，关档下候选表与策略都不编进来。

	bool "Task stack usage statistics"
	default y
	help
	  Fill pattern plus lowest-stack-pointer watermark, giving each task's
	  peak stack use.

config ARKRTOS_USE_STACK_CHECK
	bool "Stack overflow detection"
	default y
	help
	  Detect a stack overflow by the end-of-stack flag being overwritten.

config ARKRTOS_USE_STACK_GUARD
	bool "Stack bottom guard word check (switch + trap entry)"
	default n
	help
	  Read the end-of-stack flag word (ARKRTOS_STACK_END_FLAG) on every
	  task switch and at trap entry, and report the task id when it has
	  been overwritten.  This is a different question from STACK_CHECK:
	  a trap frame, a wild pointer or a DMA write can clobber the bottom
	  word while the saved PSP is still above it.  Ports that run trap
	  handlers on the interrupted task's stack (LoongArch64, RV32) need
	  this because the frame itself is what walks past the bottom.

	  Off = the flag word is still written but never read, byte-identical
	  to the previous behaviour.

config ARKRTOS_USE_SCHED_STAT
	bool "Scheduler statistics"
	default y
	depends on ARKRTOS_USE_MDK_TRACE
	help
	  Per-task switch count and time.  The counters live in
	  arkrtos_trace.c and need the DWT reader from MDK trace;
	  turning MDK trace off turns this off with it.

config ARKRTOS_USE_CPU_LOAD
	bool "CPU load statistics"
	default y
	help
	  Real-time idle ratio.

config ARKRTOS_USE_FAST_TICK_SWITCH
	bool "On-demand PendSV on tick"
	default y
	help
	  Skip the context-switch interrupt on a tick when no higher-priority
	  task became ready.  Measured at roughly half the tick overhead.

config ARKRTOS_USE_TICKLESS
	bool "Tickless idle"
	default n
	help
	  When the idle loop would sleep at least two ticks, reprogram SysTick
	  for one longer span instead of one tick at a time, then deliver the
	  skipped ticks in one go on wake.  The saving is real (at 2 kHz the
	  tick interrupt drops from 2000/s to ~125/s while idle) and so is the
	  cost: the wake path has to reconstruct how much time actually passed,
	  which is why it is off by default and why the pending ticks are
	  delivered in one batch rather than replayed from the ISR.
	  Everything is bounded by ARKRTOS_TICKLESS_MAX_TICKS, so the sleep is
	  never longer than the counter can express and the catch-up work per
	  wake stays small.

config ARKRTOS_TICKLESS_MAX_TICKS
	int "Longest skipped span (ticks)"
	default 8
	range 2 64
	help
	  Upper bound on how many ticks one sleep may skip.  8 ticks is 4 ms
	  at the default 500 us tick: long enough to matter for an idle CPU,
	  short enough that the ticks delivered on wake are cheap.  A larger
	  value saves more interrupt entries but delivers a longer burst, and
	  at 500 us/tick a span beyond ~390 ticks would not even fit SysTick's
	  24-bit counter on a fast core (the value is clamped regardless).

config ARKRTOS_USE_FAULT_RECOVER
	bool "Faulting task recovery"
	default y
	help
	  Reclaim a task slot and its resources when its exception handler runs.

config ARKRTOS_USE_MPU_APPLY_CACHE
	bool "MPU context apply cache"
	default y
	help
	  Skip rewriting the MPU registers when a task re-enters unchanged.

config ARKRTOS_USE_PAGING
	bool "Paging isolation backend (MMU)"
	default n
	help
	  Pick which implementation answers the isolation contract
	  (arkrtos_mpu_module_init/_build_task/_set_app/_set_idle/_reset):
	  off = window backend (arkrtos_mpu.c: ARM MPU / RISC-V PMP),
	  on  = page-table backend (arkrtos_paging.c: TLB + PLV).
	  The two are mutually exclusive and arkrtos_config.h rejects a build
	  that sets both, that asks for paging on a core without a TLB
	  (ARKRTOS_ARCH_HAS_PAGING_HW == 0), or that asks for paging without
	  ARKRTOS_USE_PRIV - paging isolation lands in the privilege level, so
	  it cannot work without it.  Nothing is downgraded silently.
	  The paging backend itself is static: one map built before interrupts
	  come up, ASID fixed at 0, no per-task page table, no page-frame
	  allocator, no demand paging, no copy_from_user.  Its measured
	  increment is an audit of every TCB window against the mapped spans,
	  reported as counters, plus iso=2 in the security self-check.

endmenu

menu "Synchronisation and IPC"

config ARKRTOS_USE_MQ
	bool "Message queues (SVC 0x16)"
	default y
	help
	  Semaphores, mutexes, condition variables and event groups are kernel
	  core and have no off switch here: the device framework, the POSIX
	  layer and the loader are built on them, so turning them off would
	  cascade.  Message queues are the optional one.

config ARKRTOS_USE_MEMPOOL
	bool "Fixed-block memory pool"
	default y
	help
	  arkrtos_mempool: a non-fragmenting pool whose backing store the
	  caller supplies.  Long-running components that must not depend on a
	  heap (loader staging, future socket requests) use it.

config ARKRTOS_USE_TIMER
	bool "Software timers (SVC 0x17)"
	default y

config ARKRTOS_USE_SBUF
	bool "Stream / message buffers (SVC 0x1F)"
	default n
	help
	  Byte-stream buffers (single writer, single reader) plus
	  length-prefixed message buffers on top of them.  Fills the gap
	  between the fixed-slot message queue and a raw device byte stream:
	  the storage is a static ARKRTOS_SBUF_NUM * ARKRTOS_SBUF_BUF_SIZE
	  array, so it defaults off - a project that never moves byte streams
	  pays neither RAM nor code for it.  With the gate off the SVC
	  answers -1 instead of pretending success.

config ARKRTOS_USE_ESET
	bool "32-bit event sets (SVC 0x21)"
	default n
	help
	  A 32-bit event set is a table of independent bits waited on by
	  mask.  A waiter declares the bits it wants and whether any (OR) or
	  all (AND) of them must be set, and can ask the bits to be cleared
	  when it takes them.  Different contract from the single-flag
	  event: several conditions must hold before a task starts, or
	  several producers report and the consumer needs to know which.
	  Defaults off: with the gate off the object table, the waiter slots
	  and the SVC dispatch arm are not built at all (footprint unchanged)
	  and the SVC answers -1 instead of pretending success.

endmenu

menu "Services and components"

config ARKRTOS_USE_MTX_RECURSIVE
	bool "Recursive mutexes (sync SVC sub-command 17)"
	default n
	help
	  A mutex created by arkrtos_mtx_create is still non-recursive: the
	  owner locking it twice gets RECURSIVE(-1).  A mutex created by
	  arkrtos_mtx_create_recursive may be locked again by the same task;
	  nest counts the depth and only the unlock that brings it back to 0
	  actually releases the lock / hands it to a waiter.
	  Default off: with the gate closed the create function, the SVC case
	  and the SDK wrapper are not compiled in at all (byte-identical image).

config ARKRTOS_USE_WAIT_UNBOUNDED
    bool "Unbounded number of waiters per object"
    default n
    help
      每个同步对象的等待者槽位从 ARKRTOS_MAX_SYNC_WAITERS（4）放大到
      任务表容量（ARKRTOS_TASK_MAX_NUM）。一个任务同一时刻只能等一个
      对象，所以任何对象的等待者数不可能超过任务数——对本内核而言这就是
      无上限，不需要链表也不需要堆。
      代价：所有对象表的排队槽一起线性变大（每槽 4 字节 × 各表的排队数），
      所以默认关。关掉时体积与行为逐字节不变。

config ARKRTOS_USE_WAITMULTI
	bool "Multi-object readiness probe (SVC 0x22)"
	default n
	help
	  One call takes a group of handles and answers which of them are
	  ready (semaphore has a token, queue has a message, event is set,
	  mutex is free).  It never consumes anything: the caller then takes
	  what it wants with each object's own timeout=0 call.  Blocking with
	  a timeout is done by polling in the SDK wrapper, so the wake latency
	  is one poll period, not zero - the API is a probe, not a kernel
	  blocking primitive.  Supported types: sem / mtx / mq / event; the
	  32-bit event set needs a per-entry mask and is out of scope.
	  Default off: module, SVC case and SDK wrapper are not compiled in.

config ARKRTOS_USE_LOG
	bool "Kernel log"
	default y
	help
	  The shell `log` command depends on this; it disappears with the log.

config ARKRTOS_USE_LOG_RING
	bool "Kernel log ring (dmesg)"
	default y
	depends on ARKRTOS_USE_LOG
	help
	  Keep the most recent ARKRTOS_LOG_RING_SIZE bytes of formatted log
	  lines in a ring so the `dmesg` command can print them after the
	  fact.  Off compiles the ring out entirely (no RAM, no code).

config ARKRTOS_USE_BLK
	bool "Block layer"
	default y
	help
	  Device registry and the thin layer between it and the file system.

config ARKRTOS_USE_FS
	bool "File system facade + littlefs (SVC 0x1C)"
	default y
	depends on ARKRTOS_USE_BLK

config ARKRTOS_USE_VFS
	bool "Linux-style path namespace"
	default y
	depends on ARKRTOS_USE_BLK
	help
	  / is ramfs, /dev mirrors the device registry, /mnt/<name> is a
	  persistent volume.  With this off the facade still exists (it
	  returns NOSYS) but no kernel resource is reachable by path.

config ARKRTOS_USE_PROCFS
	bool "Kernel state filesystem /proc"
	default y
	depends on ARKRTOS_USE_VFS
	help
	  Read-only, flat: version / uptime / meminfo / cpuinfo / tasks are
	  rendered from the kernel on each read and mounted at /proc.  It is a
	  mount point in the VFS namespace, so it needs ARKRTOS_USE_VFS.

config ARKRTOS_USE_VFS_LFS
	bool "littlefs backend for /mnt"
	default y
	depends on ARKRTOS_USE_VFS && ARKRTOS_USE_FS

config ARKRTOS_USE_MINIAPP
	bool "MiniApps"
	default y
	depends on ARKRTOS_USE_FS
	help
	  Load a payload from the file system into RAM on demand and run it,
	  returning the RAM when it stops.  Reuses the App image container and
	  App SDK but does not enter the image pool or take a slot.

config ARKRTOS_MINI_EXIT_IS_HANDOVER
	bool "MiniApp clean exit counts as handover"
	default y
	depends on ARKRTOS_USE_MINIAPP
	help
	  A MiniApp main task returning normally is a planned handover, so the
	  hardware-safe-state mechanism only drops the bookkeeping and does not
	  drive the hardware (the soon-to-open replacement would be jittered).
	  Off makes a clean exit behave like every other task: the device is
	  driven to its safe state.  Only the clean-exit path is affected;
	  crashes, kills and fault recovery always neutralise fully.
	  Only meaningful with ARKRTOS_USE_MINIAPP.

config ARKRTOS_USE_EXIT_CODE
	bool "Task exit code channel (U-8)"
	help
	  Carry an int32 exit code from a task back to the caller: SVC 0x1B
	  sub-command 4 records the code in the TCB, the loader captures it at
	  the moment the task flips to INVALID, and the shell prints
	  "exit code N" after exec.  arkrtos_thread_exit_code() is declared in
	  arkrtos.h in both directions.

	  Off (default) changes nothing: no TCB field, sub-command 4 rejected
	  as unknown, and arkrtos_thread_exit_code() calls
	  arkrtos_thread_exit(), so call sites need no #if.

config ARKRTOS_USE_PAGING_FRAMES
	bool "4 KB page-frame pool (U-3)"
	depends on ARKRTOS_USE_PAGING
	help
	  Maintain a 4 KB page-frame bitmap inside the physical range the board
	  gives (ARKRTOS_QEMU_FRAME_BASE / ARKRTOS_QEMU_FRAME_COUNT) and expose
	  alloc/free/total/used through the paging backend, plus one PS=22
	  identity entry so the kernel can actually reach the pool.  The App
	  window mapping is NOT changed by this option: it still uses one 2 MB
	  PS=20 entry per space, so switching it on changes no existing
	  behaviour.  Splitting the window into 4 KB pages and demand paging
	  are later stages with their own switches.

	  Off (default) changes nothing.
config ARKRTOS_USE_PAGING_PAGES
	bool "4 KB page-granular App window (U-3 stage 2)"
	depends on ARKRTOS_USE_PAGING
	depends on ARKRTOS_USE_PAGING_FRAMES
	help
	  Map the App window page by page instead of one 2 MB PS=20 entry:
	  every address space takes a 512-frame (2 MB) run from the frame pool,
	  and switching spaces rewrites the 256 STLB entries that cover the
	  window (one 4 KB entry covers two adjacent pages).  The mapping is
	  still built eagerly and frames are never returned, so this option
	  changes only how the window is mapped.

	  Off (default) changes nothing.
config ARKRTOS_USE_PAGING_DEMAND
	bool "Demand-install App window entries on first touch (U-3 stage 3)"
	depends on ARKRTOS_USE_PAGING
	depends on ARKRTOS_USE_PAGING_PAGES
	help
	  Leave the App window empty after a space switch and install one 8 KB
	  pair (two frames from the pool, one PS=12 entry) only when the program
	  first touches that pair.  The TLB refill entry saves every general
	  register before resolving, so the faulting instruction is retried with
	  its registers intact.  Frames are still never returned: this option
	  changes only when entries are installed, not when frames are freed.
	  Off (default) changes nothing.

config ARKRTOS_USE_PAGING_SWAP
	bool "Page replacement: swap a resident 8 KB pair out when the frame pool is empty (U-16)"
	depends on ARKRTOS_USE_PAGING
	depends on ARKRTOS_USE_PAGING_DEMAND
	help
	  Keep a bounded set of 8 KB pairs resident.  When the frame pool cannot
	  give two frames for the pair a program just touched, evict a resident
	  pair into a static kernel swap area (one slot per pair, 8 KB each),
	  return its two frames to the pool and install the new pair.  A later
	  touch of an evicted pair copies it back from its slot.

	  The swap area is kernel .bss, not a file: eviction runs inside the TLB
	  refill context (ISTLBR=1), where VFS calls, sleeping and locks are all
	  unavailable - the only thing that can happen there is a memory copy.
	  So this option exercises the ledger and the data movement (content is
	  byte-identical after a round trip, frame accounting returns to its old
	  value), not memory savings: the swap area itself costs memory.

	  Off (default) compiles nothing and changes no byte of the image.

config ARKRTOS_USE_PAGING_ASID
	bool "Per-space ASID, switch by CSR.ASID only (U-7)"
	depends on ARKRTOS_USE_PAGING
	depends on ARKRTOS_USE_PAGING_PAGES
	help
	  Give every App address space its own ASID (space s -> ASID s+1) and one
	  STLB way (way s % 8), so the 256 PS=12 entries that cover the window of
	  one space stay in the TLB while another space runs.  Switching a space
	  then costs one CSR.ASID write instead of 512 invtlb plus 256 tlbwr.

	  This changes the cost of a switch and which space an entry belongs to,
	  not the strength of the isolation: entries of another space simply do
	  not match, so they are misses, not aliases.  Kernel mappings (identity
	  map, UART pages, dynamic MMIO aliases) are global and stay visible under
	  every ASID.  Requires ARKRTOS_PAGING_APPS_MAX <= 8.

	  Off (default) changes nothing.

config ARKRTOS_USE_ELF
	bool "ELF64 executable loader (exec)"
	depends on ARKRTOS_USE_VFS && ARKRTOS_USE_PRIV
	help
	  Build kernelsrc/src/arkrtos_elf.c: read an ELF64 executable from the
	  VFS, lay its PT_LOAD segments into the board-provided user window and
	  start it as a PLV3 task with the Linux entry convention (sp points at
	  argc / argv / NULL / NULL envp).  The shell then accepts
	  "exec /bin/hello world" and, for a leading '/' or "./", runs the file
	  directly.

	  Off (default) compiles nothing: the image is byte-for-byte what it was
	  before this option existed, and arkrtos_elf.h still declares the API
	  (returning -1) so call sites need no #if.

	  Requires ARKRTOS_ELF_WINDOW_BASE and ARKRTOS_ELF_WINDOW_SIZE from the
	  board header (the loader does not guess address space) and a
	  privileged kernel (ARKRTOS_USE_PRIV), because the program runs at
	  PLV3 and the loader writes into its window from the kernel.

	  Scope of this first milestone: one program at a time in that single
	  static window, shared address space.  It refuses a second run with
	  ERR_BUSY instead of queueing.  Per-process page tables, the same
	  virtual address running twice, a page-frame allocator, ASID switching,
	  demand paging and copy_from_user are the next milestone, written down
	  in docs/MMU进程模型与ELF装载.md.

	  Dynamic linking is a separate switch (ARKRTOS_USE_DYNLOAD, off by
	  default).  With it off, a PT_INTERP segment is still rejected as a
	  format error rather than faulting later on an unresolved PLT slot.

config ARKRTOS_USE_DYNLOAD
	bool "Dynamic linking (PT_INTERP interpreter) for ELF user tasks"
	depends on ARKRTOS_USE_ELF
	help
	  Accept ET_EXEC / ET_DYN programs that carry PT_INTERP: load the
	  main image, load the interpreter into a board-provided region, put
	  the Linux auxv vector (AT_PHDR / AT_PHENT / AT_PHNUM / AT_PAGESZ /
	  AT_BASE / AT_ENTRY / AT_UID / AT_EUID / AT_FLAGS) on the user stack
	  and start at the interpreter entry.  The interpreter itself is a
	  user-mode program (this repo ships a minimal one in
	  example/qemu_loongarch64/elf/ldso.c), not part of the kernel.

	  Requires ARKRTOS_ELF_INTERP_BASE and ARKRTOS_ELF_INTERP_SIZE from
	  the board header; missing either is a #error, not a guessed address.
	  The main image and the interpreter are checked against disjoint
	  address ranges before a single byte is written.

	  Off (default) compiles the dynamic branch out: PT_INTERP is still
	  rejected as a format error and the image is byte-for-byte what it
	  was before this option existed.

	  Honest boundary: this is the kernel-side Linux convention plus a
	  minimal loader that resolves RELATIVE / 64 / JUMP_SLOT relocations.
	  It does NOT make a stock glibc binary run: that needs glibc's
	  ld-linux-loongarch-lp64d.so.1 and a much larger syscall surface
	  (futex, rseq, TLS, file-backed mmap).  See
	  docs/动态链接与PT_INTERP.md.

config ARKRTOS_USE_ELF_TLS
	bool "PT_TLS for ELF user tasks (static thread pointer)"
	depends on ARKRTOS_USE_ELF
	help
	  Read PT_TLS out of the loaded image and fill in only the bytes the
	  image does not already contain: a byte backed by some PT_LOAD's
	  p_filesz range is left untouched, the rest of p_memsz (tbss) is
	  zeroed, and then the task thread pointer ($r2 on LoongArch64) is
	  pointed at the TLS block before the task first runs.  The
	  "image-backed bytes are skipped" rule is not an optimisation: in a
	  real glibc static binary .tbss is NOBITS and shares its address with
	  .init_array, so zeroing by p_memsz erases the constructor table and
	  the program calls a null pointer (measured 2026-11-20).  TP is
	  preset only when this loader actually wrote something; when the
	  whole block is image-backed the address holds other data and the
	  program's own C runtime owns the TLS block (glibc builds its TCB
	  from AT_PHDR/AT_PHNUM and sets $tp itself).
	  Without this option the loader ignores PT_TLS entirely, so a
	  program that touches a __thread variable reads whatever $tp happens
	  to be -- 0 on a freshly built frame.

	  The convention implemented is the one static local-exec linking
	  actually emits: TPREL offsets are non-negative from the TLS
	  segment start, so TP = (PT_TLS p_vaddr + load bias).  Measured on
	  both the in-repo newlib toolchain and the Loongson 8.3 glibc
	  toolchain (offsets 0 and 4 for tdata/tbss of a two-variable
	  fixture).  A binary that assumes glibc's TCB layout will not be
	  served by this alone; a real libc still has to set up its own TCB.
	  Measured: with this option on, a real glibc static binary that uses
	  __thread runs to exit 3 while the loader writes zero TLS bytes and
	  leaves TP at 0 (docs/真实Linux二进制-需求清单与差距.md section 5.4).

	  LoongArch64 only for now: the set-tp hook lives in the LA64 port
	  and any other port that turns this on is a #error, not a silent
	  no-op.  Off (default) means PT_TLS is not even read: the loader,
	  the port and the image are byte-for-byte what they were before
	  this option existed.

config ARKRTOS_USE_LINUX_ABI
	bool "Linux syscall ABI for ELF user tasks"
	depends on ARKRTOS_USE_ELF
	help
	  Route the Linux system call ABI to the kernel for ELF user tasks, so a
	  statically linked Linux binary written against the asm-generic numbers
	  (openat 56, close 57, read 63, write 64, exit 93, clock_gettime 113,
	  uname 160, getpid 172, brk 214, munmap 215, mmap 222, ...) runs on a
	  target with an MMU / MPU without relinking against the Ark SDK.

	  Architecture split, both decided in the port layer:

	    - RISC-V: `ecall` already carries the number in a7; numbers
	      0x10..0x22 stay Ark's own services, everything else is offered to
	      the Linux table.
	    - LoongArch64: Ark writes its number as the `syscall` immediate,
	      Linux writes 0 and puts the number in $a7, so the two cannot
	      collide.

	  This is a compatibility layer, not a Linux kernel. Unsupported numbers
	  answer -ENOSYS and are counted; nothing is silently accepted. fork,
	  signals, inherited file descriptors and real mmap semantics (page
	  granularity, protection, file mapping) are NOT provided; pread64 and
	  mprotect exist but mprotect is accepted-not-enforced on the single
	  PS=20 RWX window -- see docs/Linux可执行文件兼容-系统调用ABI.md.
	  Dynamic linking (PT_INTERP) is provided separately by
	  ARKRTOS_USE_DYNLOAD.

	  Off (default) compiles nothing: arkrtos_linux_abi.c is not built and
	  the two port entry points are not compiled, so the image is
	  byte-for-byte what it was before this option existed.

config ARKRTOS_USE_LINUX_FORK
	bool "fork/clone + wait4 for Linux ABI user tasks (U-19)"
	depends on ARKRTOS_USE_LINUX_ABI && ARKRTOS_USE_EXIT_CODE
	depends on ARKRTOS_USE_PAGING_PAGES && ARKRTOS_USE_PAGING_DEMAND
	help
	  Add the one thing the Linux ABI layer explicitly did not have: a second
	  copy of the running program.  clone(220) accepts flags 0 or SIGCHLD
	  with child_stack == 0 (it is not a thread library: CLONE_VM and every
	  other shared-memory flag answers -EINVAL), copies the parent's address
	  space frame by frame, and rewrites a0 in the child's trap frame to 0,
	  so the parent returns the child pid and the child returns 0.  wait4(260)
	  accepts options 0 or WNOHANG.

	  Three boundaries are deliberate and documented, not bugs:
	    1) The descriptor table, pipes, signal actions and masked set are
	       per process: a child inherits a copy, and closing a descriptor in
	       the child does not close the parent's.  Pipe objects themselves
	       are shared and reference counted.  The heap cursor is still one
	       global value, not per process.
	    2) wait4 with options == 0 really blocks: the task sleeps and the
	       port rewinds ERA to the syscall so it is replayed on wakeup
	       (the same shape as Linux ERESTARTSYS).  A port without replay
	       support answers -EAGAIN.
	    3) A child must be reaped before its task slot is reused.  Each TCB
	       carries a registration generation; a wait4 that arrives after the
	       slot was reused answers -ECHILD instead of reporting a stranger.

	  Requires ARKRTOS_USE_PAGING_PAGES and ARKRTOS_USE_PAGING_DEMAND (the
	  space copy exists only on the LoongArch64 demand-paging port).

	  Off (default) compiles nothing: the three new port entry points, the
	  loader's fork entry and syscalls 220/260 are all absent, so the image is
	  byte-for-byte what it was before this option existed.

config ARKRTOS_USE_PAGING_COW
	bool "Copy-on-write fork (U-19b)"
	depends on ARKRTOS_USE_LINUX_FORK
	depends on ARKRTOS_USE_PAGING_DEMAND
	help
	  Make fork share the parent's 8 KB pairs read-only instead of copying
	  them eagerly: every pair the parent owns is pointed at by the child too
	  (reference count 1 -> 2) and both entries are downgraded to read-only.
	  The first store into a shared pair raises Ecode=PIS, la_pg_cow_fault()
	  copies that pair, installs a writable entry for the faulting space and
	  ertn returns to the faulting instruction.  Frames are not returned to
	  the pool until the last space pointing at them is released.

	  Boundaries (deliberate, not bugs):
	    1) The copy granularity is this port's mapping unit, one 8 KB pair:
	       a PS=12 entry carries both lo0 and lo1 and shares a single WE bit,
	       so "writable here, read-only there" cannot be expressed.
	    2) Pairs that were swapped out do not share: their content lives in a
	       swap slot owned by one space, so fork falls back to a real copy.
	    3) If the frame pool cannot give two frames at fault time, the fault
	       is handed back to the original kill path - never a half-installed
	       writable entry, which would let two processes share one page.

	  Requires ARKRTOS_USE_LINUX_FORK and ARKRTOS_USE_PAGING_DEMAND.

	  Off (default) compiles no reference table and no fault handler; fork
	  keeps copying frame by frame, so the image does not change by a byte.

config ARKRTOS_USE_PAGING_SHM
	bool "MAP_SHARED anonymous pages across fork (U-19c)"
	depends on ARKRTOS_USE_PAGING_COW
	help
	  Make mmap(MAP_SHARED|MAP_ANONYMOUS) real: the pairs are allocated and
	  zeroed at mmap time and marked shared, so fork only bumps the reference
	  count instead of copying them.  Parent and child then see each other's
	  writes through the same physical frames - a store never splits a shared
	  pair the way copy-on-write splits a private one.

	  Three boundaries (not bugs):
	    1) The granularity is this port's 8 KB pair: a 4 KB shared mapping
	       owns the whole pair, so a private mapping cannot share it.
	    2) Sharing is inherited through fork only.  There is no shm_open, no
	       file-backed mapping and no fd passing, so two unrelated processes
	       cannot open the same object.
	    3) The reference count is the COW tier's ledger, hence the dependency.

	  Off (default) compiles no shared-pair table, no mapping entry point and
	  no log line: mmap still answers -ENOSYS for MAP_SHARED and the image
	  does not change by a byte.

config ARKRTOS_USE_LINUX_FUTEX
	bool "futex WAIT / WAKE for the Linux ABI layer (U-20)"
	depends on ARKRTOS_USE_LINUX_ABI
	help
	  Make futex(uaddr, FUTEX_WAIT, val) / futex(uaddr, FUTEX_WAKE, n) real
	  for static ELF programs: WAIT returns -EAGAIN when the word at uaddr no
	  longer equals val, -EINTR when a signal is pending, and otherwise queues
	  the task; WAKE wakes up to n waiters on the same key and returns how
	  many it woke.

	  The key is "physical frame + offset in page", not the virtual address:
	  each process owns its own 8 KB pair window, so the same VA points at
	  different frames in parent and child, while a futex must name the same
	  word.  Two processes sharing a MAP_SHARED page therefore land on the
	  same key.

	  Three boundaries (not bugs):
	    1) Only WAIT and WAKE exist.  REQUEUE, PI and WAIT_BITSET answer
	       -ENOSYS instead of being approximated.
	    2) With a paging window, only words inside it have a key; a futex on
	       a stack word answers -ENOSYS.  Without a window (MPU backend) the
	       whole address space is one, so the virtual address is the key.
	    3) There is no unbounded sleep: the wait is replayed every scheduler
	       slice and simply re-blocks while the word is unchanged, so it never
	       invents -ETIMEDOUT.

	  Requires ARKRTOS_USE_LINUX_ABI.

	  Off (default) compiles no wait slots, no key resolver and no log line:
	  the futex number falls through to the default -ENOSYS and the image
	  does not change by a byte.

config ARKRTOS_USE_WIDE_SVC_ARGS
	bool "Native-width SVC parameter block (wide-argument ABI, U-18)"
	help
	  Widen every native SVC parameter block from uint32 slots to the
	  target's native word width (unsigned long), so an App under a wide
	  VA window can pass pointers above 4 GB.  The subcommand number stays
	  in p[0] and is tagged with ARKRTOS_SVC_SUB_WORD (0x80000000) in the
	  wide build; block validation goes through ARKRTOS_SVC_ARG_BYTES().
	  All 30 kernel svc_*() handlers verify "block in user RAM and marker
	  set" with SVC_WIDE_GUARD(), so a kernel and an App built with
	  different settings cannot silently agree on a wrong layout: the
	  wide kernel prints a one-shot log line and rejects the call.

	  This is a compile-time switch, not adaptive -- kernel and App must
	  be built with the same value.  On 32-bit targets (ARM, RV32, LA32)
	  the option is a no-op by construction: ARKRTOS_SVC_WIDE_ARGS also
	  requires __SIZEOF_LONG__ > 4.  Off (default) changes nothing on any
	  target: the slot type, the block bytes and the dispatcher are
	  byte-for-byte what they were before this option existed.

	  Not covered: kernelsrc/sdk/mini_sdk/arkc stays u32-based (it is
	  compiled separately from arkc's deployment manifest and never sees
	  these headers).  The SVC return register is only 32 bits, so in the
	  wide build a mempool block above 4 GB yields 0 plus a one-shot log
	  line rather than a truncated address.

config ARKRTOS_LINUX_ABI_SYSSTAT
	bool "Per-number syscall histogram for the Linux ABI (lxstat)"
	depends on ARKRTOS_USE_LINUX_ABI
	help
	  Keep a 16-slot sparse histogram of the Linux syscall numbers ELF user
	  tasks actually issue, so the shell can answer "which calls does this
	  binary really need" instead of guessing from an ABI table.

	      lxstat          print totals and the per-number table

	  Why it exists: the open question for running stock distribution
	  binaries is not "which calls are missing" but "which calls are actually
	  reached", and those two lists are different.  The totals already count
	  -ENOSYS; this table adds the number that produced it.  Slots that run
	  out are counted as overflow, never silently dropped.

	  Off (default) costs nothing: no table, no shell command, and
	  arkrtos_linux_abi.c is what it was before this option existed.

config ARKRTOS_USE_MODLOAD
	bool "VxWorks-style downloadable modules (ld / lkup / modules / unld)"
	depends on ARKRTOS_USE_VFS && ARKRTOS_USE_PRIV
	help
	  Build kernelsrc/src/arkrtos_modld.c and arkrtos_exports.c: read an
	  ELF64 relocatable object (.o) from the VFS, lay its allocated
	  sections into a board-provided module area, resolve every undefined
	  symbol against the kernel export table (kernelsrc/src/
	  arkrtos_exports.c, a whitelist of { name, address }), apply the
	  LoongArch64 relocations on the board, and start module_main(argc,
	  argv) as a task.  The shell then accepts:
	      ld /mnt/ram/modhello.o a b   load and run
	      lkup [name]                  list / query exported symbols
	      modules                      list resident modules
	      unld <index>                 unload a finished module

	  This is a SECOND application model, not a replacement for
	  ARKRTOS_USE_ELF.  The two answer different questions and may be
	  enabled together (2x2 matrix, all four combinations build):

	    |                | Linux-style (ELF)  | VxWorks-style (MODLOAD) |
	    | input          | ET_EXEC executable | ET_REL object (.o)      |
	    | address        | fixed at link time | chosen at load time     |
	    | external refs  | self-contained     | resolved by name        |
	    | privilege      | PLV3 (isolated)    | PLV0 (kernel)           |
	    | audience       | end-user programs  | kernel plug-ins         |

	  Enable this only if you accept that trade: a module runs in kernel
	  mode and therefore has no memory isolation from the kernel (the
	  VxWorks 5.x model).  A module that writes a bad pointer takes the
	  system down; ARKRTOS_USE_ELF is the option that keeps the wall.

	  Off (default) compiles nothing: the image is byte-for-byte what it
	  was before this option existed, and arkrtos_modld.h /
	  arkrtos_export.h still declare the API (returning -1) so call sites
	  need no #if.

	  Requires ARKRTOS_MOD_AREA_SIZE from the
	  board header (the loader does not guess address space), a
	  privileged kernel, and a 64-bit port: the relocation decoder is
	  LoongArch64-specific.  Unsupported relocation types are rejected
	  with the type number rather than guessed.

config ARKRTOS_USE_APPPACK
	bool "Relocatable image packer (four-pass diff)"
	default n
	help
	  Build kernelsrc/src/arkrtos_apppack.c: turn four compilations of the
	  same program at four nominal bases into one .svcm container carrying
	  a relocation table.  Off (default) does not compile the file at all,
	  so the image is byte-for-byte what it was before this option existed.

	  The diff only looks at how the same bytes differ between two bases,
	  so it is independent of the compiler's IR, backend and optimisation
	  level - which is what lets the PC tool (tools/pack_app.py) be checked
	  byte-for-byte against the copy running on the board.  Currently the
	  only caller is the arkc component's "cc --pack".  The packer does no
	  file I/O and allocates nothing (buffers come from the caller), so it
	  does not force the VFS in.

config ARKRTOS_PACK_IN_EXTRAM
	bool "Packer workspace in external SDRAM"
	default n
	help
	  Where the on-board packer (cc --pack, ARKRTOS_USE_APPPACK) keeps its
	  four-pass diff workspace: off (default) uses the on-chip .ark_buf window
	  carved by the partition header; on moves it into the external SDRAM
	  partition (0xC0000000), which is the only way the four passes fit at
	  the "pool 4 MB / source 512 KB" scale.  It has to agree with the
	  partition header and with ARKRTOS_USE_SDRAM: a build that turns this
	  on without the SDRAM window linked in fails to link, on purpose,
	  instead of silently shrinking the pool.

config ARKRTOS_MINI_READ_VFS
	bool "MiniApp: read images through the VFS namespace"
	default n
	depends on ARKRTOS_USE_MINIAPP && ARKRTOS_USE_VFS
	help
	  Where a MiniApp image is read from.  Off (default) reads through
	  arkrtos_fs (a mounted littlefs volume), byte-for-byte what the loader
	  did before this option existed.  On reads through the VFS namespace,
	  which also covers the volatile ramfs where the on-board compiler drops
	  its output - the only place a just-built image can be at that moment.
	  Not "try one then the other": the two backends have different
	  preconditions, so silently falling back would explain a broken read on
	  one namespace as a path in the other.

config ARKRTOS_MINI_TASK_PRIORITY
	int "MiniApp task priority"
	default 10
	range 1 255
	depends on ARKRTOS_USE_MINIAPP
	help
	  Priority handed to the task that runs a MiniApp.  The default equals
	  APP_TASK_PRIORITY, which is the kernel's historical behaviour.  The
	  H743 example passes 20 instead: a demo MiniApp that spins forever at
	  priority 10 sits above the shell (14) and takes the console down with
	  it, so there the MiniApp is put below the console.  Numbers are
	  lower-is-higher, as everywhere else in the scheduler.

config ARKRTOS_MINI_YIELD_CHUNKS
	int "MiniApp load: yield every N chunks (0 = never)"
	default 1
	range 0 1024
	depends on ARKRTOS_USE_MINIAPP
	help
	  While a MiniApp is loading, release and retake the scheduler lock
	  every N chunks so a higher-priority task (a control loop) gets the
	  CPU between reads.  A single chunk read is atomic under the lock, so
	  releasing it cannot let two loaders interleave.  0 keeps the lock
	  for the whole load, exactly as before this option existed.

config ARKRTOS_USE_TASK_SWAP
	bool "Task hot swap (A/B in-place switch, seamless upgrade)"
	default n
	help
	  Compile the kernel half of a two-buffer (A/B) seamless upgrade: swap a
	  running task onto another image at its next SVC, in place - rewrite the
	  stacked PC to the new entry, move PSP to the copied data block, refit the
	  MPU windows.  No task restart, no scheduler round trip, no flash write,
	  no file-system traffic.

	  Off (default) compiles none of it: the image is byte-for-byte what it was
	  before this option existed.  It changes where the exception return lands,
	  which is not something a default build should carry before it has been
	  verified on a board.

	  Preconditions are deliberate: the two images must declare the same RAM
	  block size (the block is copied byte-for-byte, so the data layout must
	  match), and a task whose stacked frame is the FPU-extended one is refused
	  rather than guessed at.  Adds `mini swap <path>` and `app swap <slot>`
	  only when enabled.
	  
	  This is a Cortex-M mechanism: the frame it rewrites is the ARM exception
	  frame (r0-r3/r12/lr/pc/xpsr) and the PSP it moves exists only there.
	  Selecting it on RISC-V or LoongArch is a compile-time error, not a
	  silently different behaviour - the same code would rewrite a0 as r0
	  and send the task fetching from a wrong address.

config ARKRTOS_USE_POSIX
	bool "POSIX / Windows compatibility layer"
	default y
	help
	  pthread / dirent / file POSIX names on top of the native oslib.

config ARKRTOS_POSIX_WRAP_STDLIB
	bool "POSIX layer wraps malloc/free"
	default n

config ARKRTOS_USE_MDK_TRACE
	bool "MDK trace capture"
	default y
	help
	  components/mdk_trace; needs DWT/ITM hardware.

config ARKRTOS_USE_CM_BACKTRACE
	bool "cm_backtrace fault traceback"
	default y
	help
	  components/cm_backtrace; needs DWT/NVIC.

config ARKRTOS_USE_SOFTBUS
	bool "Software bus (components/ark_softbus)"
	default n
	help
	  Cross-device event / remote-call / data-plane bus.  The component is
	  a synced copy of the ark_softbus repository; the kernel side wires
	  the board hooks, an in-board loopback link and the `bus` console
	  command.  Off compiles no bus code at all.  Enabling it also needs
	  the per-MCU -DARK_BUS_* set in the project, or arkrtos_softbus.h
	  fails the build with #error instead of quietly taking defaults.

endmenu

menu "Shell"

config ARKRTOS_USE_SHELL
	bool "Kernel shell console (SVC 0x1A)"
	default y
	help
	  The console task: command table, line editing, history, completion
	  and the board/app command registration.  It is a whole task plus
	  three kilobytes of stack, and it is by far the largest single
	  optional block in the image (measured: -33184 B Flash / -14620 B
	  RAM on the STM32F427 example).  Off compiles kernelsrc/shell down
	  to an empty object: arkrtos_shell_init() returns 0 and every
	  command disappears.

config ARKRTOS_SHELL_GLOB
	bool "Shell glob expansion (unquoted * and ?)"
	default y
	help
	  Expand an unquoted word that contains '*' or '?' against the VFS
	  namespace, the way a POSIX shell does.  A quoted pattern is left
	  alone, a pattern that matches nothing stays literal, and a match
	  set that does not fit is reported instead of truncated.  Off makes
	  '*' and '?' ordinary characters again.

config ARKRTOS_SHELL_PROMPT_LINUX
	bool "Linux-style prompt (user@host:cwd$)"
	default y
	help
	  Draw the prompt as ark@arkrtos:<cwd>$ and give the shell a working
	  directory (cd / pwd) with Linux relative-path handling.  Off falls
	  back to the plain "ark> " prompt with no working directory.

config ARKRTOS_SHELL_REDIRECT
	bool "Shell operators: quotes, ; && ||, | pipe, > >> < redirect"
	default y
	help
	  Parse the input line the way a POSIX shell does: quotes and
	  backslash escapes, command sequences (; && ||), pipelines (|)
	  and file redirection (>, >>, <).  A pipeline runs
	  store-and-forward through a RAM buffer, so a stage whose output
	  does not fit the buffer fails loudly instead of being silently
	  truncated.  Off leaves the plain whitespace split, and the
	  operators are then ordinary characters.

config ARKRTOS_SHELL_REDIRECT_BUF
	int "Redirect / pipeline capture buffer (bytes per slot)"
	depends on ARKRTOS_SHELL_REDIRECT
	default 1024
	range 128 8192
	help
	  Size of each of the two capture buffers a pipeline alternates
	  between.  Both live in the kernel RAM window; a board with a
	  tight budget lowers this, or turns ARKRTOS_SHELL_REDIRECT off
	  in its project file (-DARKRTOS_SHELL_REDIRECT=0).

config ARKRTOS_USE_SHELL_AUTH
	bool "Console login for the interactive shell"
	default n
	depends on ARKRTOS_USE_SHELL
	help
	  Require a password before the interactive shell accepts commands.
	  The console starts locked; login unlocks it, logout (or the boot
	  after too many wrong passwords) locks it again.  The password is
	  never stored or compared in clear: the project supplies a 16-byte
	  salt and the SHA-256 of salt||password through
	  ARKRTOS_SHELL_AUTH_SALT / ARKRTOS_SHELL_AUTH_DIGEST (see
	  tools/shell_auth_cred.py).  Enabling this without those two
	  symbols is a compile error, not a silent open door.
	  Honest limits: the password crosses the serial line in clear (the
	  board has no trusted display), and the stored digest can be
	  brute-forced offline if the image leaks.  This gates the console;
	  it is not a device identity (SEC-G13).

config ARKRTOS_SHELL_AUTH_TRIES
	int "Wrong passwords before the console locks until reset"
	depends on ARKRTOS_USE_SHELL_AUTH
	default 5
	range 1 100
	help
	  Number of consecutive wrong passwords tolerated.  At the limit the
	  console locks hard until the next reset, so a serial brute force
	  has to reboot the board for every TRIES guesses.  No exponential
	  backoff: on a slow serial line a delay only makes guessing cheaper
	  per unit time.

endmenu

menu "Reliability and operations"

config ARKRTOS_USE_IMAGE_SIGN
	bool "Image digital signature (HMAC-SHA256)"
	default n
	help
	  Verify the image signature at install time.  Requires a 32-byte
	  pre-shared key ARKRTOS_IMAGE_SIGN_KEY, supplied by the project (-D).
	  Symmetric by design: this is tamper detection plus provenance, not a
	  full trust chain.

config ARKRTOS_USE_EXEC_SIGN
	bool "Signature gate for exec and ld (requires IMAGE_SIGN)"
	default n
	depends on ARKRTOS_USE_IMAGE_SIGN
	help
	  When on, arkrtos_elf_exec() and arkrtos_mod_load() accept only files
	  that end with a 32-byte HMAC-SHA256 tag covering everything before it
	  (tools/sign_payload.py appends it).  Off keeps both loaders exactly as
	  they were -- no extra size, symbols or behaviour.  The App
	  install/upgrade path stays under ARKRTOS_USE_IMAGE_SIGN.

config ARKRTOS_USE_CRASH_LOG
	bool "Cross-reset crash journal"
	default y

config ARKRTOS_USE_KERNEL_GUARD
	bool "Heartbeat contract and watchdog guard"
	default y
	help
	  Really bites only when the board sets ARKRTOS_WDG_ENABLE.

config ARKRTOS_USE_AUDIT
	bool "Structural self-check"
	default y
	help
	  Partition table / slot / image header consistency checks and an
	  audit record.  Off keeps the loader's minimal legality checks only.

config ARKRTOS_HW_SAFE
	bool "Hardware safe state on task death (last words)"
	default n
	help
	  A driver may register a neutralise callback declaring "when my owner
	  dies, bring this device back to a safe state" (stop a motor PWM, drop
	  a relay).  The kernel keeps a per-task ownership ledger and runs the
	  callback from the kernel - not from the crashing App - when the task
	  dies, is killed or is fault-recovered.  Off leaves the device
	  open/close and task-death paths exactly as before.

config ARKRTOS_USE_ARKVIM
	bool "Text editor (arkvim)"
	default n
	help
	  The upstream arkvim modal editor wired to the kernel VFS, plus the
	  `vim` shell command.  Requires ARKRTOS_USE_VFS.  Off compiles the
	  component out entirely and leaves the command table unchanged.

config ARKRTOS_USE_ARKC
	bool "Self-hosted C compiler (arkc)"
	default n
	help
	  arkc compiled into the kernel, wired to the VFS, plus the `cc` shell
	  command.  Requires ARKRTOS_USE_VFS.  Its static arena and buffers
	  (about 210 KB with the STM32_MIN profile) live in the NOLOAD
	  .ark_buf section, which the board may place in external SDRAM.  Off
	  compiles the component out and leaves the command table unchanged.

config ARKRTOS_USE_ARKMAKE
	bool "On-board make (arkmake)"
	default n
	depends on ARKRTOS_USE_ARKC && ARKRTOS_USE_APPPACK
	help
	  Build a MiniApp project from its makefile on the board, through the
	  same four-pass packer as `cc --pack`.  Adds the `make` shell command.
	  Off compiles arkmake out entirely; `cc --pack` still works.

config ARKRTOS_USE_SDRAM
	bool "External SDRAM (FMC SDRAM Bank1)"
	default n
	help
	  Bring the FMC SDRAM controller up during board init and run the
	  JEDEC power-up sequence.  The geometry and the two external
	  partitions (.ark_buf for the compiler arena, .extram for the ramfs
	  file buffers) come from the board's partition header.  Off touches
	  no FMC register and nothing is mapped at 0xC0000000.  When on, the
	  board also registers the `sdram` shell command (info / full-chip
	  self test).

config ARKRTOS_USE_QSPI
	bool "QSPI NOR flash block device (nor0)"
	default n
	depends on ARKRTOS_USE_BLK
	help
	  Register the on-board W25Qxx as block device nor0 and add the `nor`
	  shell command.  Off: no QSPI peripheral is touched and no block
	  device appears, so anything that wants a persistent volume (the
	  file system, automount, MiniApps kept on NOR) has nothing to mount.

config ARKRTOS_AUTOMOUNT_NOR
	bool "Mount the NOR volume at boot (board fstab)"
	default n
	depends on ARKRTOS_USE_QSPI && ARKRTOS_USE_FS && ARKRTOS_USE_VFS && ARKRTOS_USE_VFS_LFS
	help
	  Mount nor0 at ARKRTOS_AUTOMOUNT_NOR_POINT during board init, so the
	  console can `cd` into it without a manual `fs mount` / `mount`.
	  A failed mount does not block the boot: the console still comes up
	  and says why.  Mounting never formats - a blank volume stays blank
	  until someone runs `fs format` on purpose.

config ARKRTOS_AUTOMOUNT_NOR_POINT
	string "Mount point for the boot volume"
	default "/mnt/nor"
	depends on ARKRTOS_AUTOMOUNT_NOR
	help
	  Where the boot volume appears in the VFS namespace.  MiniApp paths
	  on that volume are written exactly as `mini run` takes them, so this
	  name is part of the identity string the crash bookkeeping uses;
	  changing it changes those paths too.

config ARKRTOS_USE_APPRUN
	bool "On-board app runner (app run)"
	default n
	depends on ARKRTOS_USE_VFS
	help
	  `app run <path>` loads a bare arkc-produced executable from the file
	  system into the fixed RAM window declared by the board partition header
	  (ARKRTOS_APPRUN_*), verifies the arkc prologue, and starts it as an
	  unprivileged task with its own MPU code/data windows.  No image header
	  and no relocation: the program is linked for exactly that window.  One
	  instance at a time.  Off compiles the source out entirely and leaves the
	  command table unchanged.

config ARKRTOS_USE_FLASHAPP
	bool "Run an app straight out of internal flash (app flash)"
	default n
	depends on ARKRTOS_USE_APPRUN && ARKRTOS_USE_VFS
	help
	  `app flash write <path>` copies an arkc-produced executable into the
	  flash app area declared by the board partition header (ARKRTOS_FLASHAPP_*:
	  the bank2 tail, right after the image pool), verifies it by reading the
	  bytes back, and records a 32-byte trailer (magic / length / CRC) at the
	  end of the area.  `app flash run` starts it from that area as an
	  unprivileged task, so the image survives a reset with no file system in
	  the path.  The image is checked (SP inside the RAM window, entry inside
	  the image, arkc prologue) BEFORE the area is erased: a wrong image never
	  takes away the one that still runs.  One instance at a time, and it
	  shares the app-run RAM window.  Off compiles the source out entirely and
	  leaves the command table unchanged.

config ARKRTOS_SHELL_BOARD_CMDS
	bool "Board-owned shell commands"
	default n
	depends on ARKRTOS_USE_SHELL
	help
	  Add one call inside register_kernel_commands() so the board can append
	  its own commands after ark_shell_init() has rebuilt g_cmd_table.  Before
	  that point the table is overwritten by the builtin list, so a command
	  registered during board init silently disappears ("sdram: command not
	  found").  Off: no call is compiled, the command table is unchanged.

config ARKRTOS_USE_RTSTAT
	bool "Real-time latency measurement (DWT cycle counter)"
	default n
	help
	  arkrtos_rt: timestamps in fixed places (tick entry/exit, critical
	  section enter/exit) plus two scenarios (wake after task_wait, wake of a
	  highest-priority helper task after a sem post) accumulated against the
	  DWT cycle counter; the shell gains the `rt` command.  It reports the
	  max measured on THIS board with THIS build - not a formal WCET bound.
	  Measurement costs a cycle-counter read inside every critical section,
	  so a config with this on shows a slightly larger crit.max than the same
	  config with it off; compare the two before quoting a number.  Off (the
	  default) compiles every timestamp out: zero size change, zero behaviour
	  change, and the shell command table is unchanged.

config ARKRTOS_USE_UTEST
	bool "On-board unit test framework"
	default y
	help
	  arkrtos_utest: cases self-register (constructor) and assertions are
	  accounted, not aborted; the shell gains the `utest` command.  Off
	  compiles the framework and the command out entirely.  Auto
	  registration needs constructor support (armclang / GCC).

config ARKRTOS_USE_SECCHECK
	bool "Security baseline self-check (sec command)"
	default n
	depends on ARKRTOS_USE_SHELL
	help
	  arkrtos_sec: twelve read-only checks that report PASS / FAIL /
	  FINDING / SKIP about the build in front of you - MPU/priv/stack/
	  fault/crash/audit gates, MMU slot windows, structural audit, image
	  headers, image signature policy, hardware dead-man, watchdog guard,
	  crash journal, shell authentication, flash read-out protection and
	  measured real-time counters.  It never changes state: a FAIL here
	  means the configuration is not what you think it is, a FINDING
	  means the property is genuinely absent (and is named), and SKIP
	  means this build has no path to observe it (the reason is printed).
	  It is a baseline self-check, NOT a certification statement.  Off
	  (the default) compiles the module and the `sec` command out: zero
	  size change and the shell command table is unchanged.

config ARKRTOS_USE_FDT
	bool "Flattened device tree reader (MMU tier)"
	default n
	help
	  Parse a standard flattened device tree (.dtb) at runtime: the shape a
	  Linux-style project has, where the blob sits in the image and the
	  kernel reads it at boot.  The MCU tier does not need this - for the
	  MCU the generator emits a const C table and there is nothing to parse.

	  Both descriptions come from the same DTS (tools/dts/dtc_lite.py has a
	  C output and a dtb output), so the two tiers cannot disagree.

	  Off (default) compiles arkrtos_fdt.c to nothing: no symbols, no shell
	  command, image byte-for-byte unchanged.

config ARKRTOS_USE_FDT_CONSOLE
	bool "Consume /chosen/stdout-path (device tree console binding)"
	default n
	depends on ARKRTOS_USE_FDT
	help
	  Read /chosen/stdout-path, resolve aliases and options, and decide
	  whether the console the image was built for is the device the tree
	  names.  A match is reported as such; a mismatch is reported with the
	  exact reason (compatible / reg window / status / baud conflict) and
	  the board default is kept - a tree that disagrees with the board is a
	  configuration error, not something to paper over at run time.

	  Read-only: it never reprograms the UART and never moves the console,
	  because the console is what prints the answer.

	  Off (the default) compiles arkrtos_fdt_console.c to nothing.

config ARKRTOS_USE_FDT_RES
	bool "Use the device tree as the driver config source (timer / timebase)"
	default n
	depends on ARKRTOS_USE_FDT
	help
	  Read /cpus/timebase-frequency and the timer node (found by compatible)
	  and compare reg / clock-frequency with the board constants the port
	  was compiled with.  A match is reported as such; an absent property
	  and a disagreeing value are DIFFERENT reasons (a tree that leaves the
	  internal timer undescribed is incomplete, a tree that says 10 MHz
	  while the port ticks on 25 MHz is a configuration error).

	  Read-only: it never reprograms the timer.  Changing the tick rate at
	  run time would invalidate the counts already accumulated, i.e. it
	  would turn the real-time readings into fake evidence.

	  Off (the default) compiles arkrtos_fdt_res.c to nothing.

config ARKRTOS_USE_FDT_OVERLAY
	bool "Merge a dtb fragment into the tree (minimal overlay subset)"
	default n
	depends on ARKRTOS_USE_FDT
	help
	  Apply a fragment blob to the current tree and produce a new blob in a
	  caller-provided arena.  The subset is deliberately narrow, because a
	  half-understood overlay silently produces a tree that parses but says
	  the wrong thing:

	    - only target-path (absolute) is honoured; target = <&label> needs
	      __fixups__ label resolution and is refused;
	    - fragment properties override same-named properties, new ones are
	      appended;
	    - fragment child nodes are appended as new children; a child whose
	      name already exists is REFUSED (merging two subtrees is another
	      semantic, not guessed at here);
	    - __fixups__ / __symbols__ / __local_fixups__ are refused outright;
	    - there is no delete semantics: removing a property or a node is not
	      something this code can do, and it does not pretend to.

	  The output is a standalone blob: feed it to arkrtos_fdt_load() when it
	  validates.  Nothing is written into the tree in place.

	  Off (the default) compiles arkrtos_fdt_overlay.c to nothing.

config ARKRTOS_USE_IMAGE_CRC_RECHECK
	bool "Recheck image CRC after relocation, at boot (SEC-G17)"
	default n
	depends on ARKRTOS_USE_SECCHECK
	help
	  Flash holds the image AFTER the relocation patches were applied, while
	  the crc32 in the image header covers the nominal (as-packed) form.  So
	  reading the bytes back and comparing them with the header value can
	  never match once delta is non-zero - which is why the sec item
	  images.crc_recheck used to report SKIP.

	  This option makes it observable without touching the 256-byte header
	  ABI: both deltas are recomputable from the header (nominal_base,
	  nominal_ram_base, runtime_ram_base) and the slot base, so every
	  relocation entry can be subtracted back out, and the CRC recomputed
	  over the reconstructed nominal form.  A single flipped byte anywhere in
	  header / relocation table / payload then shows up as FAIL.

	  Cost: one extra pass over each pool image, only when `sec` runs (not at
	  boot).  Off (the default) compiles the recheck out, and the sec item
	  keeps reporting SKIP with a reason that says so.

endmenu
